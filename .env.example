# Public frontend defaults. Never place private keys in VITE_ variables.
VITE_DEFAULT_CHAIN_ID=968
VITE_RELEASE_COMMIT=development

# Read-only RPC overrides are optional; the app uses documented public endpoints by default.
BOT_TESTNET_RPC_URL=https://rpc.bohr.life
BOT_MAINNET_RPC_URL=https://rpc.botchain.ai

# Deployment gates remain false until an authorized release is prepared.
DEPLOY_APPROVED=false
DEPLOY_PRIVATE_KEY=
DEPLOY_EXPECTED_DEPLOYER=
DEPLOY_EXPECTED_ABI_SHA256=
DEPLOY_EXPECTED_BYTECODE_SHA256=
DEPLOY_EXPECTED_RUNTIME_BYTECODE_SHA256=
DEPLOY_EXPECTED_SOURCE_SHA256=
DEPLOY_EXPECTED_FOUNDRY_CONFIG_SHA256=
DEPLOY_MAX_TX_COST_WEI=
DEPLOY_MAX_TOTAL_SPEND_WEI=

# Mainnet application writes remain disabled until verified smoke evidence exists.
ENABLE_MAINNET_WRITES=false
MAINNET_MAX_TX_COST_WEI=
MAINNET_MAX_TOTAL_SPEND_WEI=

# Testnet lifecycle runner. Keep these in a local shell/secret manager only.
LIFECYCLE_APPROVED=false
LIFECYCLE_RUN_ID=
LIFECYCLE_OWNER_KEY=
LIFECYCLE_SUCCESSOR_KEY=
LIFECYCLE_SUCCESSOR_2_KEY=
LIFECYCLE_UNRELATED_KEY=
LIFECYCLE_PAYOUT=
LIFECYCLE_AMOUNT_WEI=
LIFECYCLE_MAX_WAIT_SECONDS=900
LIFECYCLE_POLL_MS=4000
